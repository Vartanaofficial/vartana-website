# Server-only. Use the approved sandbox Apps Script URL for local integration tests.
GOOGLE_SCRIPT_URL=
KONSINYASI_GOOGLE_SCRIPT_URL=

# Legacy URL compatibility, never store a secret in NEXT_PUBLIC variables.
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional dedicated RPC secret (at least 32 characters).
# Must match VARTANA_RPC_SECRET in every target Apps Script project's properties.
# When empty, RPC uses ADMIN_SESSION_SECRET and the existing
# VARTANA_ARTICLE_ADMIN_KEY Apps Script property for compatibility.
ADMIN_RPC_SECRET=

# Existing shipping configuration, unaffected by Phase 01.
BITESHIP_API_KEY=
BINDERBYTE_API_KEY=
ORIGIN_DISTRICT_ID=

# Future providers: adapters must be implemented and tested before activation.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
IPAYMU_VA=
IPAYMU_API_KEY=
KIRIMINAJA_API_KEY=

# One-time server-only connection for the admin API editor. Never NEXT_PUBLIC.
NETLIFY_INTEGRATION_TOKEN=
NETLIFY_INTEGRATION_ACCOUNT_ID=
NETLIFY_INTEGRATION_SITE_ID=

# Midtrans Snap server key (sandbox or production, matching the admin setting)
MIDTRANS_SERVER_KEY=
# Public Snap client key (Dashboard > Settings > Access Keys). When set, payment is embedded in the VARTANA checkout.
MIDTRANS_CLIENT_KEY=

MIDTRANS_SIGNATURE_SECRET_KEY=
