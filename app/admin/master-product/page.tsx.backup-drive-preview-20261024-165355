"use client";

import { useCallback, useEffect, useState } from "react";
import Link from "next/link";



function getDirectImageUrl(rawUrl: string): string {
  const url = rawUrl.trim();
  if (!url) return "";

  const driveFileMatch = url.match(
    /drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/
  );

  const driveOpenMatch = url.match(
    /drive\.google\.com\/(?:open|uc)\?.*?[?&]id=([a-zA-Z0-9_-]+)/
  );

  const fileId = driveFileMatch?.[1] || driveOpenMatch?.[1];

  if (fileId) {
    return `https://drive.google.com/uc?export=view&id=${fileId}`;
  }

  return url;
}
type Product = {
  sku: string;
  productNumber?: string;
  productName: string;
  variantName?: string;
  subtitle?: string;
  status?: string;
  description?: string;
  imageUrl?: string;
  hpp?: number;
  weightGram?: number;
  active?: boolean;
};

const emptyProduct: Product = {
  sku: "",
  productName: "",
  productNumber: "",
  variantName: "",
  subtitle: "",
  status: "Active",
  description: "",
  imageUrl: "",
  hpp: 0,
  weightGram: 0,
  active: true,
};

const fieldClass =
  "w-full rounded-xl border border-[#ded8ca] bg-white px-4 py-3 text-sm text-[#173b2b] outline-none focus:border-[#a88b43]";

export default function MasterProductPage() {
  const [products, setProducts] = useState<Product[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState("all");
  const [formOpen, setFormOpen] = useState(false);
  const [editingSku, setEditingSku] = useState<string | null>(null);
  const [form, setForm] = useState<Product>(emptyProduct);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  const loadProducts = useCallback(async () => {
    setLoading(true);
    setError("");

    try {
      const response = await fetch("/api/admin/products", {
        cache: "no-store",
      });
      const data = await response.json();

      if (!response.ok || data.success !== true) {
        throw new Error(data.message || "Gagal mengambil data produk.");
      }

      setProducts(Array.isArray(data.products) ? data.products : []);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Gagal mengambil data produk. Periksa sesi admin."
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void loadProducts();
  }, [loadProducts]);

  const filteredProducts = products.filter((product) => {
    const keyword = search.toLowerCase();

    const matchesSearch = [
      product.sku,
      product.productName,
      product.variantName,
      product.productNumber,
    ].some((value) => String(value || "").toLowerCase().includes(keyword));

    const isActive = product.active !== false;
    const matchesFilter =
      filter === "all" ||
      (filter === "active" && isActive) ||
      (filter === "inactive" && !isActive);

    return matchesSearch && matchesFilter;
  });

  function startCreate() {
    setEditingSku(null);
    setForm({ ...emptyProduct });
    setMessage("");
    setError("");
    setFormOpen(true);
  }

  function startEdit(product: Product) {
    setEditingSku(product.sku);
    setForm({
      ...emptyProduct,
      ...product,
      active: product.active !== false,
    });
    setMessage("");
    setError("");
    setFormOpen(true);
  }

  function updateField<K extends keyof Product>(
    key: K,
    value: Product[K]
  ) {
    setForm((previous) => ({ ...previous, [key]: value }));
  }

  async function saveProduct(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setSaving(true);
    setError("");
    setMessage("");

    try {
      const payload = {
        ...form,
        sku: form.sku.trim(),
        productName: form.productName.trim(),
        productNumber: form.productNumber || "",
        variantName: form.variantName || "",
        subtitle: form.subtitle || "",
        status: form.active ? "Active" : "Inactive",
        description: form.description || "",
        imageUrl: form.imageUrl || "",
        hpp: Number(form.hpp || 0),
        weightGram: Number(form.weightGram || 0),
        active: form.active !== false,
      };

      const response = await fetch("/api/admin/products", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await response.json();

      if (!response.ok || data.success !== true) {
        throw new Error(data.message || "Gagal menyimpan produk.");
      }

      setMessage(data.message || "Produk berhasil disimpan.");
      setFormOpen(false);
      await loadProducts();
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Terjadi kesalahan saat menyimpan."
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <main className="min-h-screen bg-[#f7f5ef] text-[#173b2b]">
      <header className="bg-[#103b2b] px-6 py-7 text-white sm:px-10">
        <div className="mx-auto max-w-7xl">
          <Link
            href="/admin-access"
            className="text-sm text-[#dfc783] hover:text-white"
          >
            ← Kembali ke Admin Control Center
          </Link>
          <p className="mt-6 text-xs tracking-[0.25em] text-[#dfc783]">
            VARTANA INTERNAL SYSTEM
          </p>
          <h1 className="mt-2 text-3xl font-semibold sm:text-4xl">
            Master Product
          </h1>
          <p className="mt-3 text-sm text-[#d6e0d7]">
            Pusat data produk, SKU, varian, gambar, dan informasi produk.
          </p>
        </div>
      </header>

      <section className="mx-auto max-w-7xl px-6 py-8 sm:px-10">
        {message && (
          <div className="mb-5 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800">
            {message}
          </div>
        )}

        {error && (
          <div className="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
            {error}
            <button
              type="button"
              onClick={() => void loadProducts()}
              className="ml-3 font-semibold underline"
            >
              Coba lagi
            </button>
          </div>
        )}

        <div className="grid gap-4 sm:grid-cols-3">
          <div className="rounded-2xl border border-[#e1dccf] bg-white p-5">
            <p className="text-sm text-gray-500">Total Produk</p>
            <p className="mt-3 text-3xl font-semibold">{products.length}</p>
            <p className="mt-2 text-xs text-gray-500">Data master produk</p>
          </div>

          <div className="rounded-2xl border border-[#e1dccf] bg-white p-5">
            <p className="text-sm text-gray-500">Produk Aktif</p>
            <p className="mt-3 text-3xl font-semibold">
              {products.filter((product) => product.active !== false).length}
            </p>
            <p className="mt-2 text-xs text-gray-500">
              Produk yang dapat dikelola
            </p>
          </div>

          <div className="rounded-2xl border border-[#e1dccf] bg-white p-5">
            <p className="text-sm text-gray-500">Ditampilkan</p>
            <p className="mt-3 text-3xl font-semibold">
              {filteredProducts.length}
            </p>
            <p className="mt-2 text-xs text-gray-500">
              Sesuai pencarian dan filter
            </p>
          </div>
        </div>

        <section className="mt-8 rounded-2xl border border-[#e1dccf] bg-white p-5 sm:p-7">
          <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
            <div>
              <h2 className="text-xl font-semibold">Daftar Produk</h2>
              <p className="mt-1 text-sm text-gray-500">
                Tambah dan perbarui informasi master produk.
              </p>
            </div>
            <button
              type="button"
              onClick={startCreate}
              className="rounded-xl bg-[#173b2b] px-5 py-3 text-sm font-medium text-white hover:bg-[#24523d]"
            >
              + Tambah Produk
            </button>
          </div>

          <div className="mt-6 grid gap-3 sm:grid-cols-[1fr_200px]">
            <input
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="Cari SKU, nama, atau varian produk..."
              className={fieldClass}
            />
            <select
              value={filter}
              onChange={(event) => setFilter(event.target.value)}
              className={fieldClass}
            >
              <option value="all">Semua Status</option>
              <option value="active">Aktif</option>
              <option value="inactive">Nonaktif</option>
            </select>
          </div>

          <div className="mt-6 overflow-x-auto rounded-xl border border-[#e5e0d5]">
            <table className="w-full min-w-[760px] text-left text-sm">
              <thead className="bg-[#f3f0e7] text-[#526456]">
                <tr>
                  <th className="px-4 py-4 font-medium">Produk</th>
                  <th className="px-4 py-4 font-medium">SKU</th>
                  <th className="px-4 py-4 font-medium">Varian</th>
                  <th className="px-4 py-4 font-medium">HPP</th>
                  <th className="px-4 py-4 font-medium">Status</th>
                  <th className="px-4 py-4 font-medium">Aksi</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-[#eee9de]">
                {loading ? (
                  <tr>
                    <td colSpan={6} className="px-4 py-12 text-center text-gray-500">
                      Memuat data produk...
                    </td>
                  </tr>
                ) : filteredProducts.length === 0 ? (
                  <tr>
                    <td colSpan={6} className="px-4 py-12 text-center text-gray-500">
                      {products.length === 0
                        ? "Belum ada data produk yang berhasil dimuat."
                        : "Produk tidak ditemukan."}
                    </td>
                  </tr>
                ) : (
                  filteredProducts.map((product) => (
                    <tr key={product.sku} className="hover:bg-[#faf9f6]">
                      <td className="px-4 py-4">
                        <div className="flex items-center gap-3">
                          {product.imageUrl ? (
                            <img
                              src={product.imageUrl}
                              alt={product.productName}
                              className="h-12 w-12 rounded-lg border border-[#e5e0d5] object-cover"
                            />
                          ) : (
                            <div className="flex h-12 w-12 items-center justify-center rounded-lg bg-[#f3f0e7] text-xs text-gray-400">
                              Foto
                            </div>
                          )}
                          <div>
                            <p className="font-semibold">{product.productName}</p>
                            <p className="mt-1 text-xs text-gray-500">
                              {product.productNumber || "Tanpa nomor produk"}
                            </p>
                          </div>
                        </div>
                      </td>
                      <td className="px-4 py-4 font-mono text-xs">{product.sku}</td>
                      <td className="px-4 py-4">{product.variantName || "—"}</td>
                      <td className="px-4 py-4">
                        {Number(product.hpp || 0).toLocaleString("id-ID", {
                          style: "currency",
                          currency: "IDR",
                          maximumFractionDigits: 0,
                        })}
                      </td>
                      <td className="px-4 py-4">
                        <span
                          className={`rounded-full px-3 py-1 text-xs ${
                            product.active !== false
                              ? "bg-green-100 text-green-800"
                              : "bg-gray-100 text-gray-600"
                          }`}
                        >
                          {product.active !== false ? "Aktif" : "Nonaktif"}
                        </span>
                      </td>
                      <td className="px-4 py-4">
                        <button
                          type="button"
                          onClick={() => startEdit(product)}
                          className="font-semibold text-[#876c2e] hover:underline"
                        >
                          Edit
                        </button>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </section>

        {formOpen && (
          <div className="fixed inset-0 z-50 overflow-y-auto bg-black/50 p-4">
            <div className="mx-auto my-6 max-w-3xl rounded-2xl bg-[#fdfcf8] p-6 shadow-2xl sm:p-8">
              <div className="flex items-start justify-between gap-4">
                <div>
                  <p className="text-xs tracking-[0.2em] text-[#9b7b35]">
                    PRODUCT MASTER DATA
                  </p>
                  <h2 className="mt-2 text-2xl font-semibold">
                    {editingSku ? "Edit Produk" : "Tambah Produk"}
                  </h2>
                  <p className="mt-2 text-sm text-gray-500">
                    Isi informasi produk dengan benar sebelum menyimpan.
                  </p>
                </div>
                <button
                  type="button"
                  onClick={() => setFormOpen(false)}
                  className="rounded-full border border-[#ded8ca] px-3 py-2 text-sm"
                >
                  Tutup
                </button>
              </div>

              <form onSubmit={saveProduct} className="mt-7 space-y-5">
                <div className="grid gap-4 sm:grid-cols-2">
                  <label className="block text-sm font-medium">
                    SKU *
                    <input
                      required
                      minLength={2}
                      maxLength={80}
                      pattern="[A-Za-z0-9._-]+"
                      value={form.sku}
                      disabled={Boolean(editingSku)}
                      onChange={(event) => updateField("sku", event.target.value)}
                      placeholder="Contoh: VRT-01"
                      className={`${fieldClass} mt-2 disabled:bg-gray-100`}
                    />
                    {editingSku && (
                      <span className="mt-1 block text-xs text-gray-500">
                        SKU tidak dapat diubah setelah produk dibuat.
                      </span>
                    )}
                  </label>

                  <label className="block text-sm font-medium">
                    Nama Produk *
                    <input
                      required
                      maxLength={200}
                      value={form.productName}
                      onChange={(event) => updateField("productName", event.target.value)}
                      placeholder="Contoh: Signature Blend"
                      className={`${fieldClass} mt-2`}
                    />
                  </label>

                  <label className="block text-sm font-medium">
                    Nomor Produk
                    <input
                      value={form.productNumber || ""}
                      onChange={(event) => updateField("productNumber", event.target.value)}
                      className={`${fieldClass} mt-2`}
                    />
                  </label>

                  <label className="block text-sm font-medium">
                    Varian
                    <input
                      value={form.variantName || ""}
                      onChange={(event) => updateField("variantName", event.target.value)}
                      placeholder="Contoh: Herbal Signature"
                      className={`${fieldClass} mt-2`}
                    />
                  </label>

                  <label className="block text-sm font-medium">
                    Berat Produk (gram)
                    <input
                      type="number"
                      min="0"
                      value={form.weightGram ?? 0}
                      onChange={(event) => updateField("weightGram", Number(event.target.value))}
                      className={`${fieldClass} mt-2`}
                    />
                  </label>

                  <label className="block text-sm font-medium">
                    HPP (Rupiah)
                    <input
                      type="number"
                      min="0"
                      value={form.hpp ?? 0}
                      onChange={(event) => updateField("hpp", Number(event.target.value))}
                      className={`${fieldClass} mt-2`}
                    />
                  </label>
                </div>

                <label className="block text-sm font-medium">
                  Subtitle / Deskripsi Singkat
                  <input
                    value={form.subtitle || ""}
                    onChange={(event) => updateField("subtitle", event.target.value)}
                    className={`${fieldClass} mt-2`}
                  />
                </label>

                <label className="block text-sm font-medium">
                  Deskripsi Produk
                  <textarea
                    rows={4}
                    value={form.description || ""}
                    onChange={(event) => updateField("description", event.target.value)}
                    placeholder="Cerita produk, karakter rasa, dan penjelasan produk..."
                    className={`${fieldClass} mt-2`}
                  />
                </label>

                <label className="block text-sm font-medium">
                  URL Gambar Utama (HTTPS)
                  <input
                    type="url"
                    value={form.imageUrl || ""}
                    onChange={(event) => updateField("imageUrl", event.target.value)}
                    placeholder="https://..."
                    className={`${fieldClass} mt-2`}
                  />
                </label>

                {form.imageUrl && /^https:\/\//i.test(form.imageUrl) && (
                  <div className="rounded-xl border border-[#e5e0d5] bg-white p-4">
                    <p className="mb-3 text-xs text-gray-500">Pratinjau gambar</p>
                    <img
                      src={getDirectImageUrl(form.imageUrl || "")}
                      alt="Pratinjau produk"
                      className="h-40 w-40 rounded-xl border border-[#e5e0d5] object-cover"
                    />
                    <button
                      type="button"
                      onClick={() => updateField("imageUrl", "")}
                      className="mt-3 text-sm font-medium text-red-700 underline"
                    >
                      Hapus URL gambar
                    </button>
                  </div>
                )}

                <label className="block text-sm font-medium">
                  Status Produk
                  <select
                    value={form.active === false ? "inactive" : "active"}
                    onChange={(event) => updateField("active", event.target.value === "active")}
                    className={`${fieldClass} mt-2`}
                  >
                    <option value="active">Aktif</option>
                    <option value="inactive">Nonaktif</option>
                  </select>
                </label>

                {error && (
                  <p className="rounded-xl bg-red-50 p-3 text-sm text-red-700">
                    {error}
                  </p>
                )}

                <div className="flex flex-col-reverse gap-3 border-t border-[#e5e0d5] pt-5 sm:flex-row sm:justify-end">
                  <button
                    type="button"
                    onClick={() => setFormOpen(false)}
                    className="rounded-xl border border-[#ded8ca] px-5 py-3 text-sm"
                  >
                    Batal
                  </button>
                  <button
                    type="submit"
                    disabled={saving}
                    className="rounded-xl bg-[#173b2b] px-6 py-3 text-sm font-semibold text-white disabled:opacity-60"
                  >
                    {saving ? "Menyimpan..." : "Simpan Produk"}
                  </button>
                </div>
              </form>
            </div>
          </div>
        )}
      </section>
    </main>
  );
}


